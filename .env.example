# ============================================
# CarbonLens — Environment Variables
# ============================================
# Copy this file to .env and fill in the values.
# NEVER commit the .env file to version control.
# ============================================

# --- Groq AI API ---
# Obtain from: https://console.groq.com/keys
# Used for: AI-powered carbon reduction insights (server-side only)
GROQ_API_KEY=

# --- CORS Configuration ---
# The frontend origin URL allowed to access the API
# Example: http://localhost:3000 (development) or https://your-app.vercel.app (production)
ALLOWED_ORIGIN=http://localhost:3000

# --- Server Configuration ---
# Port the backend server listens on
PORT=3001

# --- Environment ---
# Set to "production" in deployed environments
NODE_ENV=development
